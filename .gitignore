# Build output — 136 MB of compiled classes, dex and intermediates.
# This is regenerated by Gradle on every build and must never be committed.
build/
*/build/
.gradle/
.kotlin/

# Local machine config — contains your absolute SDK path.
/local.properties
local.properties

# Android Studio / IntelliJ — per-machine, not shared.
.idea/
*.iml
captures/
.externalNativeBuild/
.cxx/

# Signing material. NEVER commit these: they are the private key to
# every update you ship. Keep them out of version control and back them
# up somewhere safe separately.
*.jks
*.keystore
keystore.properties

# Built artefacts. The APK lives in a GitHub Release, not in the history.
*.apk
*.aab
*.ap_
*.dex

# OS noise
.DS_Store
Thumbs.db

# Logs and temp
*.log
captures/